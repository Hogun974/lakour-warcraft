    {
      "name": "Chant des marées (recharge 5–6)",
      "type": "feat",
      "img": "icons/svg/explosion.svg",
      "system": {
        "description": {
          "value": "<p>Sss'thera chante dans une langue oubliée. Seules les créatures de son choix qui l'entendent sont concernées.</p><p><em>Jet de sauvegarde de Sagesse :</em> DD 14, chaque créature dans un rayon de 9 m. <em>Échec :</em> La cible est charmée jusqu'à la fin du prochain tour de Sss'thera ; elle doit utiliser tout son déplacement pour s'approcher d'elle, et ne peut pas l'attaquer.</p>",
          "chat": ""
        },
        "identifier": "chant-des-marees",
        "source": {
          "book": "La Kour Warcraft",
          "page": "",
          "custom": "",
          "license": "CC-BY-4.0",
          "rules": "2024",
          "revision": 1
        },
        "uses": {
          "max": "1",
          "spent": 0,
          "recovery": [
            {
              "period": "recharge",
