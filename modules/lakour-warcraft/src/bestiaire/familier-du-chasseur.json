  "items": [
    {
      "name": "Lien du chasseur",
      "type": "feat",
      "img": "icons/creatures/abilities/paw-glowing-yellow.webp",
      "system": {
        "description": {
          "value": "<p>Le familier suit les ordres de son rôdeur (action bonus) et agit juste après lui. Il ajoute le bonus de maîtrise du rôdeur à sa CA (11 + bonus), à ses jets d'attaque (Force + bonus) et à ses dégâts (1d8 + Force + bonus) ; les chiffres de cette fiche comptent un bonus de +2, celui d'un rôdeur de niveau 3 à 4. Il a 5 + cinq fois le niveau de rôdeur points de vie (20 au niveau 3). Choisissez son allure : loup, raptor, grand félin, ours ou sanglier ; les chiffres ne changent pas.</p>",
          "chat": ""
        },
        "identifier": "lien-du-chasseur",
        "source": {
